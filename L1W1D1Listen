<!DOCTYPE html>
<html lang="en-GB">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Sound Listening Mission</title>
<style>
:root{
  --pazapa-blue:#36BBD6;
  --pazapa-blue-dark:#1B7E92;
  --pazapa-green:#C9D646;
  --pazapa-yellow:#FCC104;
  --pazapa-red:#E6352B;
  --pazapa-grey-light:#EBEBEB;
  --pazapa-grey-dark:#2E2E2D;
  --radius:18px;
}
*{box-sizing:border-box;}
html,body{margin:0;padding:0;}
body{
  font-family:"Open Sans",Arial,sans-serif;
  color:var(--pazapa-grey-dark);
  background:#FFFFFF;
  line-height:1.5;
  -webkit-text-size-adjust:100%;
}
h1,h2,h3,.brand{font-family:"Filson Soft","Open Sans",Arial,sans-serif;}
.wrap{max-width:900px;margin:0 auto;padding:16px 16px 48px;}
header.bar{
  display:flex;align-items:center;justify-content:space-between;
  gap:12px;flex-wrap:wrap;
  border-bottom:4px solid var(--pazapa-blue);
  padding-bottom:10px;margin-bottom:20px;
}
.brand{font-size:1.15rem;font-weight:700;color:var(--pazapa-blue-dark);}
h1{font-size:1.5rem;margin:0;color:var(--pazapa-grey-dark);}
.lesson-tag{font-size:.95rem;color:var(--pazapa-blue-dark);font-weight:600;margin:2px 0 0;}
section.step{
  display:none;background:#FFFFFF;
  border:3px solid var(--pazapa-grey-light);
  border-radius:var(--radius);padding:22px 18px;
}
section.step.is-visible{display:block;}
section.step:focus{outline:4px solid var(--pazapa-blue-dark);outline-offset:3px;}
.step h2{font-size:1.7rem;margin:0 0 6px;text-align:center;}
.step p.lead{font-size:1.25rem;text-align:center;margin:0 0 18px;}
.sound-tag{font-weight:700;color:var(--pazapa-blue-dark);}
button{
  font-family:"Open Sans",Arial,sans-serif;font-size:1.05rem;
  min-height:48px;min-width:48px;border-radius:14px;
  border:3px solid transparent;cursor:pointer;padding:10px 22px;
}
button:focus-visible{outline:4px solid var(--pazapa-grey-dark);outline-offset:3px;}
button[disabled]{opacity:.45;cursor:not-allowed;}
.btn-main{background:var(--pazapa-blue);border-color:var(--pazapa-blue-dark);color:#FFFFFF;font-weight:700;}
.btn-main:not([disabled]):hover{background:var(--pazapa-blue-dark);}
.btn-help{background:var(--pazapa-yellow);border-color:#C89703;color:var(--pazapa-grey-dark);font-weight:700;}
.btn-done{background:var(--pazapa-green);border-color:#96A122;color:var(--pazapa-grey-dark);font-weight:700;font-size:1.2rem;padding:12px 34px;}
.btn-quiet{background:#FFFFFF;border-color:var(--pazapa-blue-dark);color:var(--pazapa-blue-dark);font-weight:700;}
.actions{display:flex;gap:12px;justify-content:center;flex-wrap:wrap;margin-top:22px;}
.helpline{display:flex;justify-content:center;margin-bottom:14px;}
.big-sound{
  display:block;margin:0 auto;width:190px;height:190px;border-radius:50%;
  background:var(--pazapa-blue);border:5px solid var(--pazapa-blue-dark);
  color:#FFFFFF;font-size:2.4rem;font-weight:700;
  font-family:"Filson Soft","Open Sans",Arial,sans-serif;
}
.big-sound[disabled]{background:var(--pazapa-grey-light);color:var(--pazapa-grey-dark);border-color:#B9B9B9;}
.characters{display:flex;gap:18px;justify-content:center;flex-wrap:wrap;margin-bottom:16px;}
.character{width:200px;text-align:center;}
.character-art{
  height:250px;display:flex;align-items:flex-end;justify-content:center;
  background:#F4FBFD;border:3px solid var(--pazapa-blue);
  border-radius:var(--radius);padding:10px;
}
.character-art img{max-height:100%;max-width:100%;width:auto;object-fit:contain;}
.character .name{
  font-family:"Filson Soft","Open Sans",Arial,sans-serif;
  font-size:1.2rem;font-weight:700;color:var(--pazapa-blue-dark);margin-top:8px;
}

/* ---- picture choice cards ---- */
.cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:16px;}
.cards.two{max-width:560px;margin:0 auto;}
.card{
  border:3px solid var(--pazapa-grey-light);border-radius:var(--radius);
  padding:12px;text-align:center;background:#FFFFFF;
  display:flex;flex-direction:column;
}
.pick{
  display:block;width:100%;flex:1 1 auto;background:#FFFFFF;
  border:3px solid var(--pazapa-blue);border-radius:14px;
  padding:10px;min-height:200px;
}
.pick:not([disabled]):hover{background:#F4FBFD;}
.pick .pic{
  height:150px;display:flex;align-items:center;justify-content:center;
  background:#F4FBFD;border-radius:12px;padding:8px;
}
.pick .pic img{max-height:100%;max-width:100%;object-fit:contain;}
.pick .mark{
  display:block;font-size:1.15rem;font-weight:700;min-height:1.6em;margin-top:8px;
  color:var(--pazapa-blue-dark);
}
/* A found picture stays fully visible — it is complete, not unavailable. */
.pick.is-correct,.pick.is-correct[disabled]{border-color:#96A122;background:#F7F9E4;opacity:1;cursor:default;}
.pick.is-correct .mark{color:var(--pazapa-grey-dark);}
.pick.is-chosen{border-color:var(--pazapa-blue-dark);}
.card .pic{
  height:150px;display:flex;align-items:center;justify-content:center;
  background:#F4FBFD;border-radius:12px;padding:8px;
}
.card .pic img{max-height:100%;max-width:100%;object-fit:contain;}
.card .word{font-family:"Filson Soft","Open Sans",Arial,sans-serif;font-size:1.35rem;font-weight:700;margin:10px 0;}
.speaker{
  background:var(--pazapa-blue);border-color:var(--pazapa-blue-dark);color:#FFFFFF;
  font-size:1.4rem;width:56px;height:56px;border-radius:50%;padding:0;
}
.speaker[disabled]{background:var(--pazapa-grey-light);color:var(--pazapa-grey-dark);border-color:#B9B9B9;}
.speaker-row{display:flex;justify-content:center;margin-top:10px;}

/* ---- "saying the sound" — lights up while a recording is playing ----
   Colour is never the only signal: the lit item also grows a thick yellow
   ring and its speaker turns yellow, and screen-reader users get the
   spoken-status line. */
.is-playing{
  box-shadow:0 0 0 6px var(--pazapa-yellow);
  border-color:var(--pazapa-yellow) !important;
}
.speaker.is-playing{
  background:var(--pazapa-yellow);color:var(--pazapa-grey-dark);
  border-color:#C89703 !important;box-shadow:0 0 0 6px rgba(252,193,4,.45);
}
.big-sound.is-playing{
  background:var(--pazapa-yellow);color:var(--pazapa-grey-dark);
  border-color:#C89703 !important;box-shadow:0 0 0 10px rgba(252,193,4,.40);
}
.pick.is-playing{background:#FFF8E2;}
.yesno-item .pic.is-playing{background:#FFF8E2;}
@media (prefers-reduced-motion: no-preference){
  .is-playing{animation:pazapaGlow 1s ease-in-out infinite alternate;}
  @keyframes pazapaGlow{
    from{box-shadow:0 0 0 4px rgba(252,193,4,.55);}
    to{box-shadow:0 0 0 9px rgba(252,193,4,.30);}
  }
}

/* ---- yes / no ---- */
.yesno-item{max-width:420px;margin:0 auto 10px;text-align:center;}
.yesno-item .pic{
  height:190px;display:flex;align-items:center;justify-content:center;
  background:#F4FBFD;border-radius:12px;padding:10px;
  border:3px solid var(--pazapa-grey-light);
}
.yesno-item .pic img{max-height:100%;max-width:100%;object-fit:contain;}
.yesno-row{display:flex;gap:16px;justify-content:center;flex-wrap:wrap;margin-top:16px;}
.btn-yesno{
  background:#FFFFFF;border-color:var(--pazapa-blue-dark);color:var(--pazapa-blue-dark);
  font-weight:700;font-size:1.35rem;min-width:150px;min-height:64px;
}
.btn-yesno:not([disabled]):hover{background:#F4FBFD;}
.progress-note{text-align:center;font-weight:600;color:var(--pazapa-blue-dark);margin:0 0 10px;}

.status{margin-top:14px;text-align:center;font-size:1.1rem;min-height:1.6em;color:var(--pazapa-blue-dark);font-weight:600;}
.final{text-align:center;}
.final h2{color:var(--pazapa-blue-dark);font-size:2rem;}
.final .tick{
  display:inline-flex;align-items:center;justify-content:center;
  width:110px;height:110px;border-radius:50%;background:var(--pazapa-green);
  font-size:3rem;margin-bottom:10px;
}
.visually-hidden{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);clip-path:inset(50%);white-space:nowrap;}
@media (prefers-reduced-motion: reduce){*{animation:none !important;transition:none !important;}}
@media (max-width:480px){
  .big-sound{width:150px;height:150px;font-size:2rem;}
  .step h2{font-size:1.4rem;}
  .character-art{height:200px;}
  .pick .pic{height:120px;}
  .card .pic{height:120px;}
  .yesno-item .pic{height:150px;}
}
</style>
</head>
<body>
<div class="wrap">

  <header class="bar">
    <!-- Official Pazapa logo file only. No official logo file supplied, so plain text is used. -->
    <div class="brand" id="brand">Pazapa Phonics</div>
    <div>
      <h1>Sound Listening Mission</h1>
      <p class="lesson-tag">Week 1 · Lesson 1 · <span class="sound-tag">/s/</span></p>
    </div>
  </header>

  <main>

    <!-- SCREEN 1 — START THE LISTENING MISSION -->
    <section class="step is-visible" id="step1" tabindex="-1" aria-labelledby="step1h"
             data-say="Sound Listening Mission. Let's start listening.">
      <h2 id="step1h">Sound Listening Mission</h2>
      <p class="lead">Let’s listen for <span class="sound-tag">/s/</span>!</p>

      <div class="helpline">
        <button type="button" class="btn-help js-say">🔊 Hear the instruction</button>
      </div>

      <div class="characters">
        <div class="character">
          <!-- Official Leo artwork — Pazapa "Read With Leo &amp; Fadi" Level 1 booklet. -->
          <div class="character-art"><img data-art="leo" alt="Leo"></div>
          <div class="name">Leo</div>
        </div>
        <div class="character">
          <!-- Official Fadi artwork — Pazapa "Read With Leo &amp; Fadi" Level 1 booklet. -->
          <div class="character-art"><img data-art="fadi" alt="Fadi"></div>
          <div class="name">Fadi</div>
        </div>
      </div>

      <div class="actions">
        <button type="button" class="btn-main" data-next="step2">Start listening</button>
      </div>
    </section>

    <!-- SCREEN 2 — LISTEN TO THE SOUND AGAIN -->
    <section class="step" id="step2" tabindex="-1" aria-labelledby="step2h" data-say="Listen.">
      <h2 id="step2h">Listen to <span class="sound-tag">/s/</span>.</h2>

      <div class="helpline">
        <button type="button" class="btn-help js-say">🔊 Hear the instruction</button>
      </div>

      <button type="button" class="big-sound" id="soundBtn" aria-label="Listen to the /s/ sound">▶</button>

      <div class="actions">
        <button type="button" class="btn-quiet" id="playAgainBtn">Play it again</button>
      </div>

      <p class="status" id="soundStatus" role="status"></p>

      <div class="actions">
        <button type="button" class="btn-main" data-next="step3">Carry on</button>
      </div>
    </section>

    <!-- SCREEN 3 — LISTEN AND CHOOSE -->
    <section class="step" id="step3" tabindex="-1" aria-labelledby="step3h"
             data-say="Which one starts with the sound you heard?">
      <h2 id="step3h">Which one starts with <span class="sound-tag">/s/</span>?</h2>

      <div class="helpline">
        <button type="button" class="btn-help js-say">🔊 Hear the instruction</button>
      </div>

      <div class="cards two" id="chooseCards"></div>
      <p class="status" id="chooseStatus" role="status" aria-live="polite"></p>

      <div class="actions">
        <button type="button" class="btn-main" id="next3" data-next="step4" disabled>Carry on</button>
      </div>
    </section>

    <!-- SCREEN 4 — LISTEN AND FIND /s/ -->
    <section class="step" id="step4" tabindex="-1" aria-labelledby="step4h"
             data-say="Find another word.">
      <h2 id="step4h">Find another <span class="sound-tag">/s/</span> word.</h2>

      <div class="helpline">
        <button type="button" class="btn-help js-say">🔊 Hear the instruction</button>
      </div>

      <div class="cards two" id="findCards"></div>
      <p class="status" id="findStatus" role="status" aria-live="polite"></p>

      <div class="actions">
        <button type="button" class="btn-main" id="next4" data-next="step5" disabled>Carry on</button>
      </div>
    </section>

    <!-- SCREEN 5 — LISTENING CHECK: YES OR NO? -->
    <section class="step" id="step5" tabindex="-1" aria-labelledby="step5h"
             data-say="Does this word start with the sound you heard?">
      <h2 id="step5h">Does this word start with <span class="sound-tag">/s/</span>?</h2>

      <div class="helpline">
        <button type="button" class="btn-help js-say">🔊 Hear the instruction</button>
      </div>

      <p class="progress-note" id="checkCount"></p>

      <div class="yesno-item">
        <div class="pic"><img id="checkImg" src="" alt=""></div>
        <div class="speaker-row">
          <button type="button" class="speaker" id="checkSpeaker" aria-label="Listen to the word">🔊</button>
        </div>
        <div class="yesno-row">
          <button type="button" class="btn-yesno" id="btnYes">Yes</button>
          <button type="button" class="btn-yesno" id="btnNo">No</button>
        </div>
      </div>

      <p class="status" id="checkStatus" role="status" aria-live="polite"></p>

      <div class="actions">
        <button type="button" class="btn-main" id="next5" data-next="step6" disabled>Carry on</button>
      </div>
    </section>

    <!-- SCREEN 6 — SPOT THE /s/ PICTURES -->
    <section class="step" id="step6" tabindex="-1" aria-labelledby="step6h"
             data-say="Tap the correct pictures.">
      <h2 id="step6h">Tap the pictures that start with <span class="sound-tag">/s/</span>.</h2>

      <div class="helpline">
        <button type="button" class="btn-help js-say">🔊 Hear the instruction</button>
      </div>

      <div class="cards" id="spotCards"></div>
      <p class="status" id="spotStatus" role="status" aria-live="polite"></p>

      <div class="actions">
        <button type="button" class="btn-main" id="next6" data-next="step7" disabled>Carry on</button>
      </div>
    </section>

    <!-- SCREEN 7 — COMPLETION -->
    <section class="step final" id="step7" tabindex="-1" aria-labelledby="step7h"
             data-say="Well done! You listened carefully.">
      <div class="tick" aria-hidden="true">✓</div>
      <h2 id="step7h">Well done!</h2>
      <p class="lead">You listened carefully for <span class="sound-tag">/s/</span>!</p>

      <div class="helpline">
        <button type="button" class="btn-help js-say">🔊 Hear the instruction</button>
      </div>

      <div class="characters">
        <div class="character">
          <div class="character-art"><img data-art="leo" alt="Leo"></div>
          <div class="name">Leo</div>
        </div>
        <div class="character">
          <div class="character-art"><img data-art="fadi" alt="Fadi"></div>
          <div class="name">Fadi</div>
        </div>
      </div>

      <div class="actions">
        <button type="button" class="btn-done" id="doneBtn" disabled>Done</button>
      </div>
      <p class="status" id="doneStatus" role="status"></p>
    </section>

  </main>
</div>

<script>
(function(){
  "use strict";

  /* ==================================================================
     BRITISH ENGLISH FEMALE VOICE — INTERFACE WORDING ONLY
     Never used for the isolated /s/ sound and never for a model word.
  ================================================================== */
  var VOICE = null;

  var FEMALE_GB = ["libby","sonia","hazel","serena","kate","google uk english female",
                   "en-gb-standard-a","fiona","amy","emma","stephanie","female"];
  var MALE_HINTS = ["daniel","george","oliver","ryan","arthur","thomas","male"];

  function pickVoice(){
    if(!window.speechSynthesis) return null;
    var vs = window.speechSynthesis.getVoices() || [];
    if(!vs.length) return null;
    var gb = vs.filter(function(v){ return /^en[-_]GB/i.test(v.lang); });
    var pool = gb.length ? gb : vs.filter(function(v){ return /^en/i.test(v.lang); });
    for(var i=0;i<FEMALE_GB.length;i++){
      for(var j=0;j<pool.length;j++){
        if(pool[j].name.toLowerCase().indexOf(FEMALE_GB[i]) !== -1) return pool[j];
      }
    }
    for(var k=0;k<pool.length;k++){
      var n = pool[k].name.toLowerCase(), male = false;
      for(var m=0;m<MALE_HINTS.length;m++){ if(n.indexOf(MALE_HINTS[m]) !== -1) male = true; }
      if(!male) return pool[k];
    }
    return pool[0] || null;
  }

  function loadVoice(){ VOICE = pickVoice(); }
  loadVoice();
  if(window.speechSynthesis && typeof window.speechSynthesis.onvoiceschanged !== "undefined"){
    window.speechSynthesis.onvoiceschanged = loadVoice;
  }

  /* ------------------------------------------------------------------
     ONE CENTRAL AUDIO ENGINE — one sound at a time, no autoplay
  ------------------------------------------------------------------ */
  var currentAudio = null;
  var litNodes    = [];

  /* Lights the item that is speaking, so the learner can see which
     picture the sound belongs to. Cleared whenever the sound stops. */
  function clearLit(){
    litNodes.forEach(function(n){ if(n){ n.classList.remove("is-playing"); } });
    litNodes = [];
  }

  function light(nodes){
    clearLit();
    (nodes || []).forEach(function(n){
      if(n){ n.classList.add("is-playing"); litNodes.push(n); }
    });
  }

  function stopAudio(){
    if(currentAudio){
      try{ currentAudio.pause(); currentAudio.currentTime = 0; }catch(e){}
      currentAudio = null;
    }
    if(window.speechSynthesis){
      try{ window.speechSynthesis.cancel(); }catch(e){}
    }
    clearLit();
  }

  /* playAudio(src)            — play a recording
     playAudio(src, [a, b])    — play it and light these elements while it sounds */
  function playAudio(src, lightNodes){
    if(!src){ console.error("Missing audio source."); return; }
    stopAudio();

    var audio = new Audio();
    audio.preload = "auto";
    audio.src = src;

    currentAudio = audio;
    light(lightNodes);

    function finish(){
      if(currentAudio === audio){
        currentAudio = null;
        clearLit();
      }
    }

    audio.addEventListener("ended", finish);
    audio.addEventListener("pause", finish);

    audio.addEventListener("error", function(){
      console.error("Audio loading error:", audio.error ? audio.error.code : "unknown");
      finish();
    });

    var promise = audio.play();

    if(promise && typeof promise.catch === "function"){
      promise.catch(function(error){
        console.error("Audio playback failed:", error);
        finish();
      });
    }
  }

  // Interface wording only — never the phoneme, never a model word.
  /* Interface wording only. The phoneme is never synthesised: these
     fallback lines deliberately contain no /s/ sound string, so the
     voice can never stand in for the official recording. */
  function speak(text, rate){
    stopAudio();
    if(!window.speechSynthesis || !window.SpeechSynthesisUtterance) return;
    if(!VOICE) loadVoice();
    var u = new SpeechSynthesisUtterance(text);
    u.lang = "en-GB";
    if(VOICE) u.voice = VOICE;
    u.rate = rate || 0.85;
    u.pitch = 1.05;
    window.speechSynthesis.speak(u);
  }

  /* ==================================================================
     OFFICIAL PAZAPA RECORDINGS

     Supplied audio files, exact names and case as delivered:
        S sound.mp3          -> sound_s     isolated /s/
        Snake.mp3            -> snake
        Salat.mp3            -> salat
        Sit.mp3              -> sit
        sun.mp3              -> sun
        apple.mp3            -> apple
        turtle.mp3           -> turtle
        listenforthe.mp3     -> instruction_1   Screen 1
        listentothe.mp3      -> instruction_2   Screen 2
        whichone.mp3         -> instruction_3   Screen 3
        findanother.mp3      -> instruction_4   Screen 4
        doesthisword.mp3     -> instruction_5   Screen 5
        tapthepicture.mp3    -> instruction_6   Screen 6
        Welldone.mp3         -> instruction_7   Screen 7

     Every recording below is the complete supplied file, embedded as a
     Base64 Data URL, so the activity needs no external audio folder and
     survives being moved, renamed or uploaded to Moodle.
     Every screen and every picture card has an official recording, so
     browser speech synthesis never speaks in this activity.
  ================================================================== */
  var AUDIO_FILES = {
    sound_s: "data:audio/mpeg;base64,",   // isolated /s/ — Screen 2

    snake:   "data:audio/mpeg;base64,",
    salat:   "data:audio/mpeg;base64,",
    sit:     "data:audio/mpeg;base64,",
    sun:     "data:audio/mpeg;base64,",
    apple:   "data:audio/mpeg;base64,",
    turtle:  "data:audio/mpeg;base64,",

    instruction_1: "data:audio/mpeg;base64,",   // "Let's listen for /s/!"                — Screen 1
    instruction_2: "data:audio/mpeg;base64,",   // "Listen to /s/."                       — Screen 2
    instruction_3: "data:audio/mpeg;base64,",   // "Which one starts with /s/?"           — Screen 3
    instruction_4: "data:audio/mpeg;base64,",   // "Find another /s/ word."               — Screen 4
    instruction_5: "data:audio/mpeg;base64,",   // "Does this word start with /s/?"       — Screen 5
    instruction_6: "data:audio/mpeg;base64,",   // "Tap the pictures that start with /s/" — Screen 6
    instruction_7: "data:audio/mpeg;base64,"    // "Well done!"                           — Screen 7
  };

  /* ==================================================================
     SOURCE VOCABULARY — W1L1 /s/
     Pictures from the Pazapa "Read With Leo & Fadi" Level 1 booklet.
     SNAKE, SALAT and SUN come from page 11 (S page); SIT uses the
     booklet's own illustration of a child sitting. SAND and SCHOOL are
     not used here. APPLE (page 12) and TURTLE (page 13) are the
     verified non-/s/ items, each with its own supplied recording.
  ================================================================== */
  /* Official character artwork, declared once and used on Screens 1 and 7.
     Fadi's slate carries the lesson letter S. */
  var CHARACTER_ART = {
    leo:  "data:image/png;base64,",
    fadi: "data:image/png;base64,"
  };

  Array.prototype.forEach.call(document.querySelectorAll("img[data-art]"), function(img){
    var src = CHARACTER_ART[img.getAttribute("data-art")];
    if(src){ img.src = src; }
  });

  var ITEMS = {
    snake:  { word:"Snake",  image:"data:image/png;base64,",  audio:AUDIO_FILES.snake, isS:true  },
    salat:  { word:"Salat",  image:"data:image/png;base64,",  audio:AUDIO_FILES.salat, isS:true  },
    sit:    { word:"Sit",    image:"data:image/png;base64,",    audio:AUDIO_FILES.sit,   isS:true  },
    sun:    { word:"Sun",    image:"data:image/png;base64,",    audio:AUDIO_FILES.sun,   isS:true  },
    apple:  { word:"Apple",  image:"data:image/png;base64,",  audio:AUDIO_FILES.apple,  isS:false },
    turtle: { word:"Turtle", image:"data:image/png;base64,", audio:AUDIO_FILES.turtle, isS:false }
  };

  /* Official instruction recordings, by screen. Every screen has one,
     so the speak() fallback is never reached in this activity — it stays
     only as a safety net if a recording is ever removed. */
  var STEP_AUDIO = {
    step1: AUDIO_FILES.instruction_1,
    step2: AUDIO_FILES.instruction_2,
    step3: AUDIO_FILES.instruction_3,
    step4: AUDIO_FILES.instruction_4,
    step5: AUDIO_FILES.instruction_5,
    step6: AUDIO_FILES.instruction_6,
    step7: AUDIO_FILES.instruction_7
  };

  /* ------------------------------------------------------------------
     INSTRUCTION VOICE BUTTONS
     An official recording always takes priority over the voice.
  ------------------------------------------------------------------ */
  function sayStep(sec, lightNode){
    if(!sec) return;
    var src = STEP_AUDIO[sec.id];
    if(src){ playAudio(src, lightNode ? [lightNode] : []); }
    else { speak(sec.getAttribute("data-say"), 0.85); }
  }

  Array.prototype.forEach.call(document.querySelectorAll(".js-say"), function(btn){
    btn.addEventListener("click", function(){ sayStep(btn.closest("section.step"), btn); });
  });

  /* ------------------------------------------------------------------
     SEQUENTIAL FLOW — ONE SCREEN AT A TIME, NO AUTO-ADVANCE
  ------------------------------------------------------------------ */
  var STEPS = ["step1","step2","step3","step4","step5","step6","step7"];
  var doneBtn = document.getElementById("doneBtn");

  doneBtn.disabled = true;

  function showStep(id){
    stopAudio();
    STEPS.forEach(function(sid){
      document.getElementById(sid).classList.toggle("is-visible", sid === id);
    });
    var target = document.getElementById(id);
    target.focus();
    if(id === "step7"){ doneBtn.disabled = completionSent; }
    // Called straight from the Carry on click, so this is a real user
    // gesture and not autoplay.
    sayStep(target);
  }

  Array.prototype.forEach.call(document.querySelectorAll("[data-next]"), function(btn){
    btn.addEventListener("click", function(){
      if(btn.disabled) return;
      showStep(btn.getAttribute("data-next"));
    });
  });

  /* ------------------------------------------------------------------
     SCREEN 2 — ISOLATED /s/
     Official recording only. Never text-to-speech, never the letter
     name "ess". Replay restarts the very same file.
  ------------------------------------------------------------------ */
  var soundBtn     = document.getElementById("soundBtn");
  var playAgainBtn = document.getElementById("playAgainBtn");
  var soundStatus  = document.getElementById("soundStatus");

  function playSoundS(){ playAudio(AUDIO_FILES.sound_s, [soundBtn]); }

  if(!AUDIO_FILES.sound_s){
    soundBtn.disabled = true;
    playAgainBtn.disabled = true;
    soundStatus.textContent = "The sound is not ready yet. You can carry on.";
  }else{
    soundBtn.addEventListener("click", playSoundS);
    playAgainBtn.addEventListener("click", playSoundS);
  }

  /* ------------------------------------------------------------------
     SHARED — build a tappable picture card
  ------------------------------------------------------------------ */
  function buildPick(item, onPick){
    var wrapEl = document.createElement("div");
    wrapEl.className = "card";

    var btn = document.createElement("button");
    btn.type = "button";
    btn.className = "pick";
    btn.setAttribute("aria-label", item.word);

    var pic = document.createElement("div");
    pic.className = "pic";
    var img = document.createElement("img");
    img.src = item.image;
    img.alt = item.word;
    pic.appendChild(img);
    btn.appendChild(pic);

    var mark = document.createElement("span");
    mark.className = "mark";
    btn.appendChild(mark);

    btn.addEventListener("click", function(){ onPick(item, btn, mark); });
    wrapEl.appendChild(btn);

    // Every picture card carries a speaker. Where an official recording
    // exists the button plays it and lights the card while it sounds;
    // where none was supplied the button is disabled and says so, which
    // never blocks progress.
    var row = document.createElement("div");
    row.className = "speaker-row";
    var sp = document.createElement("button");
    sp.type = "button";
    sp.className = "speaker";
    sp.innerHTML = "🔊";
    sp.disabled = !item.audio;
    sp.setAttribute("aria-label",
      item.audio ? ("Listen to " + item.word) : ("No recording for " + item.word));
    sp.addEventListener("click", function(){
      playAudio(item.audio, [btn, sp]);
    });
    row.appendChild(sp);
    wrapEl.appendChild(row);

    btn.pazapaSpeaker = sp;
    return wrapEl;
  }

  /* Two-choice screens: one verified /s/ target, one verified non-/s/ item. */
  function buildChoice(hostId, statusId, nextId, target, distractor, correctText, wrongText){
    var host   = document.getElementById(hostId);
    var status = document.getElementById(statusId);
    var next   = document.getElementById(nextId);
    var solved = false;

    function onPick(item, btn, mark){
      if(solved && item.isS) return;
      if(item.isS){
        solved = true;
        btn.classList.add("is-correct");
        mark.textContent = "✓ " + item.word;
        status.textContent = correctText;
        next.disabled = false;
        if(item.audio){ playAudio(item.audio, [btn, btn.pazapaSpeaker]); }
      }else{
        btn.classList.add("is-chosen");
        status.textContent = wrongText;   // unlimited retries, no error styling
      }
    }

    [target, distractor].forEach(function(item){
      host.appendChild(buildPick(item, onPick));
    });
  }

  /* ------------------------------------------------------------------
     SCREEN 3 — LISTEN AND CHOOSE
  ------------------------------------------------------------------ */
  buildChoice("chooseCards", "chooseStatus", "next3",
              ITEMS.sun, ITEMS.apple,
              "Yes! Sun starts with /s/.",
              "Listen again and try once more.");

  /* ------------------------------------------------------------------
     SCREEN 4 — LISTEN AND FIND /s/
  ------------------------------------------------------------------ */
  buildChoice("findCards", "findStatus", "next4",
              ITEMS.snake, ITEMS.turtle,
              "Good listening! Snake starts with /s/.",
              "Try listening again.");

  /* ------------------------------------------------------------------
     SCREEN 5 — LISTENING CHECK: YES OR NO?
  ------------------------------------------------------------------ */
  var CHECKS = [ ITEMS.salat, ITEMS.turtle ];

  var checkImg     = document.getElementById("checkImg");
  var checkSpeaker = document.getElementById("checkSpeaker");
  var checkStatus  = document.getElementById("checkStatus");
  var checkCount   = document.getElementById("checkCount");
  var btnYes       = document.getElementById("btnYes");
  var btnNo        = document.getElementById("btnNo");
  var next5        = document.getElementById("next5");
  var checkIndex   = 0;

  function showCheck(){
    var item = CHECKS[checkIndex];
    checkImg.src = item.image;
    checkImg.alt = item.word;
    checkCount.textContent = "Picture " + (checkIndex + 1) + " of " + CHECKS.length;
    checkStatus.textContent = "";
    // Speaker only where an official recording exists.
    checkSpeaker.disabled = !item.audio;
    checkSpeaker.setAttribute("aria-label",
      item.audio ? ("Listen to " + item.word) : "No recording for this word");
  }

  var checkPic = checkImg.parentNode;

  checkSpeaker.addEventListener("click", function(){
    var item = CHECKS[checkIndex];
    playAudio(item.audio, [checkPic, checkSpeaker]);
  });

  function answerCheck(saidYes){
    var item = CHECKS[checkIndex];
    var right = (saidYes === item.isS);
    if(!right){
      checkStatus.textContent = "Listen again and try once more.";
      return;
    }
    checkStatus.textContent = item.isS
      ? "Yes! That begins with /s/."
      : "That’s right. This word does not begin with /s/.";
    if(item.audio){ playAudio(item.audio, [checkPic, checkSpeaker]); }

    if(checkIndex < CHECKS.length - 1){
      checkIndex += 1;
      window.setTimeout(function(){
        // moves to the next picture only after the learner has answered
        showCheck();
      }, 900);
    }else{
      next5.disabled = false;
    }
  }

  btnYes.addEventListener("click", function(){ answerCheck(true); });
  btnNo.addEventListener("click", function(){ answerCheck(false); });
  showCheck();

  /* ------------------------------------------------------------------
     SCREEN 6 — SPOT THE /s/ PICTURES
  ------------------------------------------------------------------ */
  var SPOT = [ ITEMS.snake, ITEMS.sit, ITEMS.sun, ITEMS.apple ];

  var spotHost   = document.getElementById("spotCards");
  var spotStatus = document.getElementById("spotStatus");
  var next6      = document.getElementById("next6");
  var spotTargets = SPOT.filter(function(i){ return i.isS; }).length;
  var spotFound   = 0;

  SPOT.forEach(function(item){
    spotHost.appendChild(buildPick(item, function(it, btn, mark){
      if(it.isS){
        if(btn.classList.contains("is-correct")) return;   // stays chosen, cannot repeat
        btn.classList.add("is-correct");
        btn.disabled = true;
        mark.textContent = "✓ " + it.word;
        spotFound += 1;
        spotStatus.textContent = "Good listening! " + it.word + " starts with /s/.";
        if(it.audio){ playAudio(it.audio, [btn, btn.pazapaSpeaker]); }
        if(spotFound === spotTargets){
          spotStatus.textContent = "Good listening! You found all the /s/ pictures.";
          next6.disabled = false;
        }
      }else{
        btn.classList.add("is-chosen");
        spotStatus.textContent = "Listen again. Can you hear /s/?";
      }
    }));
  });

  /* ------------------------------------------------------------------
     MOODLE COMPLETION — one time only, on Done
  ------------------------------------------------------------------ */
  var completionSent = false;

  function activityCompleted(){
    if(completionSent) return;
    completionSent = true;
    console.log("W1L1 Sound Listening Mission /s/ completed");
  }

  doneBtn.addEventListener("click", function(){
    if(doneBtn.disabled) return;
    stopAudio();
    activityCompleted();
    doneBtn.disabled = true;
    document.getElementById("doneStatus").textContent = "Saved.";
    // Moodle manages course navigation — nothing navigates from here.
  });

  /* ------------------------------------------------------------------
     INITIAL STATE — only Screen 1 is visible, Done is closed
  ------------------------------------------------------------------ */
  STEPS.forEach(function(sid, i){
    document.getElementById(sid).classList.toggle("is-visible", i === 0);
  });
  doneBtn.disabled = true;

})();
</script>
</body>
</html>
